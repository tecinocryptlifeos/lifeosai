name = "losai-edge-gateway"
main = "../../services/edge-gateway/src/index.js"
compatibility_date = "2026-08-01"
workers_dev = true
send_metrics = false

# Cloudflare Worker is the authoritative production API edge.
# External provider origins are intentionally not configured here.

[observability]
enabled = true

# Production has no scheduled handler. Explicitly remove any stale cron trigger.
[triggers]
crons = []

[vars]
LIFEOS_ALLOWED_ORIGINS = "__LIFEOS_ALLOWED_ORIGINS__"
LIFEOS_PUBLIC_SITE_ORIGIN = "__LIFEOS_PUBLIC_SITE_ORIGIN__"
LIFEOS_API_ORIGIN = "__LIFEOS_API_ORIGIN__"
SUPABASE_URL = "__SUPABASE_URL__"
SUPABASE_PUBLISHABLE_KEY = "__SUPABASE_PUBLISHABLE_KEY__"
LIFEOS_EMAIL_AUTH_ENABLED = "true"
LIFEOS_REGISTRATION_ENABLED = "true"
LIFEOS_GOOGLE_AUTH_ENABLED = "true"
LIFEOS_MINIMUM_AGE = "13"
LIFEOS_PASSWORD_MIN_LENGTH = "10"
LIFEOS_GEMINI_LIVE_PRIMARY_MODEL = "gemini-3.8-live"
LIFEOS_GEMINI_LIVE_FALLBACK_MODEL = "gemini-3.1-flash-live-preview"

[[kv_namespaces]]
binding = "ORIGIN_STATE"
id = "__ORIGIN_STATE_KV_ID__"

[[ratelimits]]
name = "API_RATE_LIMITER"
namespace_id = "__RATE_LIMIT_NAMESPACE_ID__"

  [ratelimits.simple]
  limit = 5
  period = 60
